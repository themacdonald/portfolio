{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://portfolio.themacdonald.dev/schema/portfolio.schema.json",
  "title": "AgenticPortfolioPayload",
  "type": "object",
  "required": [
    "metadata",
    "dashboard",
    "localizationRegistry",
    "systemArchitectureDAG"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "engineerName",
        "targetTitle",
        "globalTelemetryVersion",
        "systemLocation",
        "availableLanguages",
        "compiledTimestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "engineerName": {
          "type": "string"
        },
        "targetTitle": {
          "type": "string"
        },
        "globalTelemetryVersion": {
          "type": "string"
        },
        "systemLocation": {
          "type": "string"
        },
        "availableLanguages": {
          "type": "array",
          "minItems": 7,
          "items": {
            "enum": [
              "en",
              "fr",
              "es",
              "de",
              "ru",
              "ja",
              "zh"
            ]
          }
        },
        "compiledTimestamp": {
          "type": "string"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "required": [
        "generatedAt",
        "capturedDaysAgo",
        "metrics",
        "tiles",
        "charts",
        "repositories",
        "contributionWeeks",
        "verdict",
        "datasetProfiles",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "capturedDaysAgo": {
          "type": "integer"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "value",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "unit": {
                "enum": [
                  "count",
                  "percent",
                  "score",
                  "date",
                  "ratio"
                ]
              },
              "context": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "github",
                  "derived",
                  "config"
                ]
              },
              "sourceDetail": {
                "type": "string"
              },
              "emphasis": {
                "type": "boolean"
              }
            }
          }
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "value",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "unit": {
                "enum": [
                  "count",
                  "percent",
                  "score",
                  "date",
                  "ratio"
                ]
              },
              "context": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "github",
                  "derived",
                  "config"
                ]
              },
              "sourceDetail": {
                "type": "string"
              },
              "emphasis": {
                "type": "boolean"
              }
            }
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "heatmap",
                  "distribution",
                  "strips",
                  "signals"
                ]
              },
              "unit": {
                "enum": [
                  "count",
                  "percent",
                  "score",
                  "date",
                  "ratio"
                ]
              },
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "period",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "period": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "series": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string"
                    },
                    "level": {
                      "type": "integer"
                    }
                  }
                }
              },
              "segments": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    },
                    "share": {
                      "type": "number"
                    }
                  }
                }
              },
              "source": {
                "enum": [
                  "github",
                  "derived",
                  "config"
                ]
              },
              "sourceDetail": {
                "type": "string"
              }
            }
          }
        },
        "verdict": {
          "type": "object",
          "required": [
            "code",
            "tone",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "sparse",
                "bursty",
                "steady",
                "sustained"
              ]
            },
            "tone": {
              "enum": [
                "caution",
                "neutral",
                "strong"
              ]
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "contributionWeeks": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date",
                "value",
                "level"
              ],
              "additionalProperties": false,
              "properties": {
                "date": {
                  "type": "string"
                },
                "value": {
                  "type": "integer"
                },
                "level": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "language",
              "stars",
              "forks",
              "openIssues",
              "topics",
              "url",
              "pushedAt",
              "createdAt",
              "sizeKb",
              "archived",
              "isFork",
              "track",
              "readiness"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "language": {
                "type": "string"
              },
              "stars": {
                "type": "integer"
              },
              "forks": {
                "type": "integer"
              },
              "openIssues": {
                "type": "integer"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "homepage": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "pushedAt": {
                "type": "string"
              },
              "createdAt": {
                "type": "string"
              },
              "sizeKb": {
                "type": "integer"
              },
              "archived": {
                "type": "boolean"
              },
              "isFork": {
                "type": "boolean"
              },
              "track": {
                "type": "string"
              },
              "readiness": {
                "type": "integer"
              }
            }
          }
        },
        "datasetProfiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "source",
              "rows",
              "columns",
              "groups",
              "counts",
              "numeric"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "enum": [
                  "dataset"
                ]
              },
              "rows": {
                "type": "integer"
              },
              "columns": {
                "type": "integer"
              },
              "groups": {
                "type": "integer"
              },
              "yearFrom": {
                "type": "string"
              },
              "yearTo": {
                "type": "string"
              },
              "lifeMean": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lifeMin": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lifeMax": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "strongest": {
                "type": [
                  "object",
                  "null"
                ],
                "required": [
                  "a",
                  "b",
                  "r"
                ],
                "additionalProperties": false,
                "properties": {
                  "a": {
                    "type": "string"
                  },
                  "b": {
                    "type": "string"
                  },
                  "r": {
                    "type": "number"
                  }
                }
              },
              "counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "numeric": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "min",
                    "max",
                    "mean"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "mean": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "capturedAt": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "localizationRegistry": {
      "type": "object",
      "required": [
        "en",
        "fr",
        "es",
        "de",
        "ru",
        "ja",
        "zh"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "interfaceLabels",
          "shellLabels",
          "profileNarrative",
          "notebookCells",
          "projectDetails"
        ],
        "additionalProperties": false,
        "properties": {
          "interfaceLabels": {
            "type": "object",
            "required": [
              "kernelStatus",
              "runCellBtn",
              "workspaceFiles",
              "telemetryOutput",
              "recentGrowthTitle"
            ],
            "additionalProperties": false,
            "properties": {
              "kernelStatus": {
                "type": "string"
              },
              "runCellBtn": {
                "type": "string"
              },
              "workspaceFiles": {
                "type": "string"
              },
              "telemetryOutput": {
                "type": "string"
              },
              "recentGrowthTitle": {
                "type": "string"
              }
            }
          },
          "shellLabels": {
            "type": "object",
            "required": [
              "runAllBtn",
              "clearBtn",
              "cellLabel",
              "localeLabel",
              "cellsLabel",
              "narrativeLinesLabel",
              "codeLinesLabel",
              "telemetryRowsLabel",
              "growthItemsLabel",
              "dagPayloadLabel",
              "outputIdle",
              "outputRunning",
              "rawConsoleLabel",
              "repositoryLabel",
              "domainLabel",
              "weightLabel",
              "edgeManifestLabel",
              "highestCriticalityLabel",
              "nodesLabel",
              "edgesLabel",
              "viewModeRecruiter",
              "viewModeTechnical",
              "menuLabel",
              "reduceMotionLabel",
              "viewDashboard",
              "viewWork",
              "verifiedLabel",
              "selfReportedLabel",
              "unmeasuredLabel"
            ],
            "additionalProperties": false,
            "properties": {
              "runAllBtn": {
                "type": "string"
              },
              "clearBtn": {
                "type": "string"
              },
              "cellLabel": {
                "type": "string"
              },
              "localeLabel": {
                "type": "string"
              },
              "cellsLabel": {
                "type": "string"
              },
              "narrativeLinesLabel": {
                "type": "string"
              },
              "codeLinesLabel": {
                "type": "string"
              },
              "telemetryRowsLabel": {
                "type": "string"
              },
              "growthItemsLabel": {
                "type": "string"
              },
              "dagPayloadLabel": {
                "type": "string"
              },
              "outputIdle": {
                "type": "string"
              },
              "outputRunning": {
                "type": "string"
              },
              "rawConsoleLabel": {
                "type": "string"
              },
              "repositoryLabel": {
                "type": "string"
              },
              "domainLabel": {
                "type": "string"
              },
              "weightLabel": {
                "type": "string"
              },
              "edgeManifestLabel": {
                "type": "string"
              },
              "highestCriticalityLabel": {
                "type": "string"
              },
              "nodesLabel": {
                "type": "string"
              },
              "edgesLabel": {
                "type": "string"
              },
              "viewModeRecruiter": {
                "type": "string"
              },
              "viewModeTechnical": {
                "type": "string"
              },
              "menuLabel": {
                "type": "string"
              },
              "reduceMotionLabel": {
                "type": "string"
              },
              "viewDashboard": {
                "type": "string"
              },
              "viewWork": {
                "type": "string"
              },
              "verifiedLabel": {
                "type": "string"
              },
              "selfReportedLabel": {
                "type": "string"
              },
              "unmeasuredLabel": {
                "type": "string"
              }
            }
          },
          "profileNarrative": {
            "type": "object",
            "required": [
              "title",
              "headline",
              "summary",
              "focusAreas"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "headline": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "focusAreas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "dashboardLabels": {
            "type": "object",
            "required": [
              "sectionTitles",
              "sectionCaptions",
              "metricLabels",
              "chartTitles",
              "chartCaptions",
              "sourceLabels",
              "trackLabels",
              "trackBlurbs",
              "caseProblem",
              "caseMethod",
              "caseOutcome",
              "caseRole",
              "caseTimeframe",
              "caseProvenance",
              "availability",
              "contactLabels",
              "verdicts"
            ],
            "additionalProperties": false,
            "properties": {
              "sectionTitles": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "sectionCaptions": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "metricLabels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "chartTitles": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "chartCaptions": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "sourceLabels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "trackLabels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "trackBlurbs": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "caseProblem": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "caseMethod": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "caseOutcome": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "caseRole": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "caseTimeframe": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "caseProvenance": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "availability": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "contactLabels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "verdicts": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "notebookCells": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "sourceLines"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "type": {
                  "enum": [
                    "markdown",
                    "code"
                  ]
                },
                "sourceLines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "executionMetadata": {
                  "type": "object",
                  "required": [
                    "requiresKernel",
                    "simulatedTelemetry"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "requiresKernel": {
                      "enum": [
                        "python3",
                        "cpp20"
                      ]
                    },
                    "simulatedTelemetry": {
                      "type": "object",
                      "required": [
                        "metricsHeader",
                        "outputFields",
                        "records"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "metricsHeader": {
                          "type": "string"
                        },
                        "outputFields": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "records": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "object"
                              ]
                            }
                          }
                        },
                        "rawConsoleLog": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "projectDetails": {
            "type": "object",
            "required": [
              "BiasGuard",
              "FeedbackLoop",
              "ConfidenceCoach",
              "AgriMANET-Scheduler"
            ],
            "additionalProperties": {
              "type": "object",
              "required": [
                "description",
                "updatedFeatures"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string"
                },
                "updatedFeatures": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "systemArchitectureDAG": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "domain",
              "subSystem",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "subSystem": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "dependencyType"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "dependencyType": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
